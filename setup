#!/usr/bin/env bash
# ==============================================================================
# setup — Packaging, Build & Installation Script for omarchy-sony
# Project: omarchy-sony (Sony WH-1000XM5 Plugin & Headless Bluetooth Daemon)
# ==============================================================================
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors for terminal output
BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

info() {
  printf "${BLUE}${BOLD}[INFO]${NC} %s\n" "$*"
}

success() {
  printf "${GREEN}${BOLD}[SUCCESS]${NC} %s\n" "$*"
}

warn() {
  printf "${YELLOW}${BOLD}[WARN]${NC} %s\n" "$*"
}

error() {
  printf "${RED}${BOLD}[ERROR]${NC} %s\n" "$*" >&2
}

print_help() {
  cat << 'HELP_EOF'
Usage: setup [OPTIONS]

Set up omarchy-sony: verify/install build dependencies, compile binaries,
install binaries to ~/.local/bin, install and enable the systemd user service,
and deploy the Omarchy bar-widget plugin.

Options:
  -h, --help    Display this help message and exit 0

Steps performed:
  1. Detect Arch Linux (ID_LIKE=arch or /etc/arch-release) and check for
     required packages: bluez-libs (or bluez), dbus, cmake, ninja, gcc/clang.
     Install missing packages via omarchy pkg add or sudo pacman -S.
  2. Configure and build daemon and CLI using CMake and Ninja:
     cmake -B build -G Ninja && cmake --build build
  3. Install sony-headphones-daemon and sony-ctl into ~/.local/bin (mode 0755).
  4. Copy daemon/sony-headphones.service to ~/.config/systemd/user/,
     reload systemd daemon, and enable the service unit.
  5. Deploy plugin/ to ~/.local/share/omarchy/shell/plugins/io.github.androydified.omasony,
     verify no symlinks exist, and validate via omarchy-plugin-validate if present.
HELP_EOF
}

# Handle command line flags
for arg in "$@"; do
  case "$arg" in
    -h|--help)
      print_help
      exit 0
      ;;
    *)
      error "Unknown option: $arg"
      echo ""
      print_help
      exit 1
      ;;
  esac
done

is_arch_linux() {
  if [[ -f /etc/arch-release ]]; then
    return 0
  fi
  if [[ -f /etc/os-release ]] && grep -qE '^ID(_LIKE)?=.*arch' /etc/os-release; then
    return 0
  fi
  return 1
}

check_and_install_dependencies() {
  info "Checking system dependencies..."
  if ! is_arch_linux; then
    info "Non-Arch distribution detected; skipping pacman dependency checks."
    return 0
  fi

  local missing_pkgs=()

  # Check bluez-libs or bluez
  if ! pacman -Q bluez-libs >/dev/null 2>&1 && ! pacman -Q bluez >/dev/null 2>&1; then
    missing_pkgs+=("bluez-libs")
  fi

  # Check dbus
  if ! pacman -Q dbus >/dev/null 2>&1; then
    missing_pkgs+=("dbus")
  fi

  # Check cmake (check pacman or command in PATH)
  if ! pacman -Q cmake >/dev/null 2>&1 && ! command -v cmake >/dev/null 2>&1; then
    missing_pkgs+=("cmake")
  fi

  # Check ninja (check pacman or command in PATH)
  if ! pacman -Q ninja >/dev/null 2>&1 && ! command -v ninja >/dev/null 2>&1; then
    missing_pkgs+=("ninja")
  fi

  # Check gcc or clang (check pacman or command in PATH)
  if ! pacman -Q gcc >/dev/null 2>&1 && ! pacman -Q clang >/dev/null 2>&1 && \
     ! command -v gcc >/dev/null 2>&1 && ! command -v clang >/dev/null 2>&1; then
    missing_pkgs+=("gcc")
  fi

  if [[ ${#missing_pkgs[@]} -gt 0 ]]; then
    info "Missing dependencies detected: ${missing_pkgs[*]}"
    if command -v omarchy >/dev/null 2>&1; then
      info "Installing dependencies via: omarchy pkg add ${missing_pkgs[*]}"
      omarchy pkg add "${missing_pkgs[@]}"
    elif command -v pacman >/dev/null 2>&1; then
      info "Installing dependencies via: sudo pacman -S --needed --noconfirm ${missing_pkgs[*]}"
      sudo pacman -S --needed --noconfirm "${missing_pkgs[@]}"
    else
      error "Cannot install missing packages: neither omarchy nor pacman is available."
      exit 1
    fi
  else
    success "All build dependencies are satisfied."
  fi
}

build_project() {
  info "Configuring project with CMake and Ninja..."
  cmake -S "$ROOT_DIR" -B "$ROOT_DIR/build" -G Ninja
  info "Building daemon and CLI targets..."
  cmake --build "$ROOT_DIR/build"
  success "Build completed successfully."
}

install_binaries() {
  info "Installing binaries into $HOME/.local/bin..."
  mkdir -p "$HOME/.local/bin"

  local daemon_bin="$ROOT_DIR/build/daemon/sony-headphones-daemon"
  local ctl_bin="$ROOT_DIR/build/cli/sony-ctl"

  if [[ ! -f "$daemon_bin" ]]; then
    error "Daemon binary not found at $daemon_bin"
    exit 1
  fi
  if [[ ! -f "$ctl_bin" ]]; then
    error "CLI binary not found at $ctl_bin"
    exit 1
  fi

  install -m 0755 "$daemon_bin" "$HOME/.local/bin/sony-headphones-daemon"
  install -m 0755 "$ctl_bin" "$HOME/.local/bin/sony-ctl"
  success "Binaries installed to $HOME/.local/bin/ (mode 0755)."
}

install_systemd_service() {
  info "Installing systemd user service..."
  local service_src="$ROOT_DIR/daemon/sony-headphones.service"
  local service_dir="$HOME/.config/systemd/user"
  local service_dest="$service_dir/sony-headphones.service"

  if [[ ! -f "$service_src" ]]; then
    error "Service unit not found at $service_src"
    exit 1
  fi

  mkdir -p "$service_dir"
  install -m 0644 "$service_src" "$service_dest"

  info "Reloading systemd user daemon and enabling sony-headphones.service..."
  systemctl --user daemon-reload 2>/dev/null || true
  systemctl --user enable sony-headphones.service 2>/dev/null || true
  success "Systemd user service installed and enabled."
}

deploy_plugin() {
  info "Deploying Omarchy bar-widget plugin..."
  local plugins_dir="$HOME/.local/share/omarchy/shell/plugins"
  local plugin_dest="$plugins_dir/io.github.androydified.omasony"
  local user_plugins_dir="$HOME/.config/omarchy/plugins"
  local user_plugin_dest="$user_plugins_dir/io.github.androydified.omasony"

  mkdir -p "$plugin_dest" "$user_plugin_dest"
  rm -rf "$plugin_dest"/* "$user_plugin_dest"/*

  for file in manifest.json Panel.qml Service.qml Model.js SonyIcon.qml; do
    if [[ -f "$ROOT_DIR/$file" ]]; then
      cp "$ROOT_DIR/$file" "$plugin_dest/"
      cp "$ROOT_DIR/$file" "$user_plugin_dest/"
    fi
  done

  # Validate plugin if validator is present
  local validator="/usr/share/omarchy/bin/omarchy-plugin-validate"
  if [[ -x "$validator" ]]; then
    info "Validating plugin using $validator..."
    "$validator" "$ROOT_DIR"
    success "Plugin validation passed."
  fi

  success "Plugin deployed to $plugin_dest and $user_plugin_dest."

  if command -v omarchy >/dev/null 2>&1; then
    info "Enabling plugin io.github.androydified.omasony in Omarchy..."
    # The shell answers "unknown" for a plugin it has not scanned yet, so
    # rescan and wait for it to show up before enabling, as omarchy-plugin-add does.
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
    local attempt
    for (( attempt = 0; attempt < 40; attempt++ )); do
      if omarchy plugin list --json 2>/dev/null |
        jq -e 'any(.[]; .id == "io.github.androydified.omasony")' >/dev/null 2>&1; then
        break
      fi
      sleep 0.05
    done
    if ! omarchy plugin enable io.github.androydified.omasony; then
      warn "Could not enable the plugin. Enable it later with: omarchy plugin enable io.github.androydified.omasony"
    fi
  fi
}

main() {
  info "Starting omarchy-sony setup..."
  check_and_install_dependencies
  build_project
  install_binaries
  install_systemd_service
  deploy_plugin
  chmod 755 "$ROOT_DIR/setup" 2>/dev/null || true
  success "omarchy-sony setup completed successfully!"
}

main
